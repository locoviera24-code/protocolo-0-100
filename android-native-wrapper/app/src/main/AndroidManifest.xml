<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Protocolo 0→100"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".WorkoutWidgetProvider"
            android:exported="false"
            android:label="Protocolo 0→100 · Gym">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.protocolo.cien.ACTION_REFRESH_WORKOUT_WIDGET" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_REPS_DOWN" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_REPS_UP" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_WEIGHT_DOWN" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_WEIGHT_UP" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_WEIGHT_FAST_DOWN" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_WEIGHT_FAST_UP" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_SAVE_SET" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_REPEAT_LAST" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_PREVIOUS_EXERCISE" />
                <action android:name="com.protocolo.cien.ACTION_WIDGET_NEXT_EXERCISE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/workout_widget_info" />
        </receiver>
        <receiver
            android:name=".WorkoutControlReceiver"
            android:exported="false" />
    </application>
</manifest>
