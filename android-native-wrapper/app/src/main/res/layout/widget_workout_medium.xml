<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Lunes — Torso A"
        android:textColor="#eef5ff"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Pecho · Espalda · Hombro · Bíceps · Tríceps"
        android:textColor="#98f5c2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetExercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Peck deck · Press banca · Dominadas · Jalón · Laterales · Press militar"
        android:textColor="#dbeaff"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0/9 ejercicios · 0 series"
        android:textColor="#8fa3c3"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetOpenButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="Abrir entrenamiento"
            android:textColor="#eef5ff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetQuickButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Registrar serie"
            android:textColor="#06111f"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetRefreshButton"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="↻"
            android:textColor="#eef5ff"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
