<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Lunes - Torso A"
        android:textColor="#eef5ff"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Pecho · Espalda · Hombro"
        android:textColor="#98f5c2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widgetExercises"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Peck deck · Press banca · Dominadas · Jalon"
        android:textColor="#dbeaff"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0/9 ejercicios · 0 series"
        android:textColor="#8fa3c3"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/widgetDirectPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetCurrentExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Press de banca"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetSetStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ejercicio: 0 series · Pecho: 0 series"
            android:textColor="#98f5c2"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetLoadGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Última: sin datos · Mejor: sin datos"
            android:textColor="#dbeaff"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetRepsMinusButton"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="-"
                android:textColor="#eef5ff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetQuickReps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="8 reps"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetRepsPlusButton"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="+"
                android:textColor="#eef5ff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetWeightMinusButton"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="-"
                android:textColor="#eef5ff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetQuickWeight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="0 kg"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetWeightPlusButton"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="+"
                android:textColor="#eef5ff"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetWeightFastMinusButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="-5 kg"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetWeightFastPlusButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="+5 kg"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetSaveSetButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.35"
                android:background="@drawable/widget_button"
                android:gravity="center"
                android:text="Guardar serie"
                android:textColor="#06111f"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetRepeatButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="Repetir"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetPreviousButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="Atrás"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetNextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="Siguiente"
                android:textColor="#eef5ff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetActionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ajusta reps/kg y guarda desde el widget."
            android:textColor="#ffd36e"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/widgetTimerPanel"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Chronometer
                android:id="@+id/widgetTimerChronometer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="Descanso 01:30"
                android:textColor="#eef5ff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetTimerButton"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/widget_button_secondary"
                android:gravity="center"
                android:text="Iniciar"
                android:textColor="#eef5ff"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetOpenButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="Abrir"
            android:textColor="#eef5ff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetQuickButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="Abrir registro"
            android:textColor="#eef5ff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetRefreshButton"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="↻"
            android:textColor="#eef5ff"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
