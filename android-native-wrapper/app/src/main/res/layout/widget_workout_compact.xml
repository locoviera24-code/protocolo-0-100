<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widgetDirectPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/widgetCurrentExercise"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Elegir ejercicio"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:text="Elegir ejercicio"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetSetStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Serie 1"
            android:textColor="#98f5c2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widgetLoadGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Última: sin datos · Mejor: sin datos"
            android:textColor="#dbeaff"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetQuickReps"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="Repeticiones preparadas"
                android:gravity="center"
                android:text="8 reps"
                android:textColor="#eef5ff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetQuickWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="Carga preparada"
                android:gravity="center"
                android:text="0 kg"
                android:textColor="#eef5ff"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widgetSaveSetButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button"
                android:contentDescription="Guardar serie preparada"
                android:minHeight="48dp"
                android:text="Guardar"
                android:textAllCaps="false"
                android:textColor="#06111f"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/widgetRepeatButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="Editar la serie preparada"
                android:minHeight="48dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="#eef5ff"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetActionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Listo para guardar"
            android:textColor="#ffd36e"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/widgetTimerPanel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Chronometer
                android:id="@+id/widgetTimerChronometer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="Temporizador de descanso"
                android:gravity="center"
                android:textColor="#eef5ff"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/widgetTimerButton"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="Controlar temporizador"
                android:minHeight="48dp"
                android:text="Iniciar"
                android:textAllCaps="false"
                android:textColor="#eef5ff"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
