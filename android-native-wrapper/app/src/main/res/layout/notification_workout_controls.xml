<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <Button
        android:id="@+id/notificationExerciseButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_button_secondary"
        android:contentDescription="Elegir ejercicio"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="48dp"
        android:paddingHorizontal="10dp"
        android:text="Elegir ejercicio"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notificationGuidance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ultima: sin datos · Max: sin datos"
        android:textColor="#dbeaff"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notificationRepsMinusButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Disminuir repeticiones"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="-"
            android:textColor="#eef5ff"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/notificationQuickReps"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Repeticiones preparadas"
            android:gravity="center"
            android:text="8 reps"
            android:textColor="#eef5ff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notificationRepsPlusButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Aumentar repeticiones"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="+"
            android:textColor="#eef5ff"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notificationWeightPanel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notificationWeightFastMinusButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Disminuir carga 5 kilos"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="-5"
            android:textAllCaps="false"
            android:textColor="#eef5ff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/notificationWeightMinusButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Disminuir carga 0,5 kilos"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="-0,5"
            android:textAllCaps="false"
            android:textColor="#eef5ff"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notificationQuickWeight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Carga preparada"
            android:gravity="center"
            android:text="0 kg"
            android:textColor="#eef5ff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notificationWeightPlusButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Aumentar carga 0,5 kilos"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="+0,5"
            android:textAllCaps="false"
            android:textColor="#eef5ff"
            android:textSize="12sp" />

        <Button
            android:id="@+id/notificationWeightFastPlusButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Aumentar carga 5 kilos"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="+5"
            android:textAllCaps="false"
            android:textColor="#eef5ff"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/notificationSaveSetButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="Guardar serie preparada"
        android:minHeight="48dp"
        android:text="Guardar serie"
        android:textAllCaps="false"
        android:textColor="#06111f"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
