{
  "name": "protocolo-0-100",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:precache": "node scripts/generate-precache-manifest.mjs",
    "build:pwa-screenshots": "node scripts/capture-pwa-screenshots.mjs",
    "test:manifest": "node scripts/test-manifest.mjs",
    "test:precache": "node scripts/generate-precache-manifest.mjs --check && node scripts/test-build-guard.mjs",
    "test:quality-gate": "node scripts/test-quality-gate.mjs",
    "test:native-controls": "node scripts/test-native-workout-controls.mjs && node scripts/test-workout-load-guidance.mjs",
    "build:web": "node scripts/generate-precache-manifest.mjs && node scripts/build-web-dist.mjs",
    "test:web-dist": "node scripts/test-web-dist.mjs",
    "test:web-dist:e2e": "playwright test --config=playwright.web-dist.config.mjs",
    "test:rules": "npx --yes firebase-tools@15.23.0 emulators:exec --project demo-protocolo-0100 --only firestore \"node firebase/rules.test.mjs\"",
    "test:modules": "node scripts/test-module-boundaries.mjs",
    "test:design": "node scripts/test-design-system.mjs",
    "test:router": "node scripts/test-router.mjs",
    "test:layout": "node scripts/test-layout-coordinator.mjs",
    "test:home-settings": "node scripts/test-home-settings.mjs",
    "test:progress": "node scripts/test-progress-view.mjs && node scripts/test-muscle-progress.mjs && node scripts/test-exercise-progress.mjs",
    "test:version": "node scripts/sync-app-version.mjs --check && node scripts/test-version-alignment.mjs",
    "test:settings": "node scripts/test-settings-contract.mjs",
    "test:data": "node scripts/test-schema-registry.mjs && node scripts/test-feature-flags.mjs && node scripts/test-data-integrity.mjs && node scripts/test-data-layer.mjs && node scripts/test-backup-service.mjs",
    "test:nutrition": "node scripts/test-numbers.mjs && node scripts/test-nutrition-modules.mjs && node scripts/test-food-search-service.mjs",
    "test:fdc": "node scripts/test-fdc-confidence.mjs",
    "test:axe": "playwright test tests/e2e/accessibility-axe.spec.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.61.1",
    "firebase": "^12.0.0"
  }
}
